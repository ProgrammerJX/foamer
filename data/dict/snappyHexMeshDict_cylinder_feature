/*--------------------------------*- C++ -*----------------------------------*\
| Cylinder1 L=2 + Snap #7 feature snap (implicitFeatureSnap=true)。
| 与 snappyHexMeshDict_cylinder 同骨架，把 STL feature edge / corner 拉出来；
| 配合 sample 的 buildFeatures 调用，让 cap 边缘在出网格里保持锋利。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    cylinder1.stl
    {
        type triSurfaceMesh;
        name cylinder1;
    }
}

castellatedMeshControls
{
    maxLocalCells       200000;
    maxGlobalCells      400000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        cylinder1 { level (2 2); }
    }
    locationInMesh (0.9 0.9 0.9);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch          3;
    nSmoothInternal       2;
    tolerance             2.0;
    nSolveIter            30;
    nRelaxIter            5;
    nFeatureSnapIter      10;
    implicitFeatureSnap   true;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
}
