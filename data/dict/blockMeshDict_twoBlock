/*--------------------------------*- C++ -*----------------------------------*\
| Two-block background：把 [-1,1]^3 沿 x 切为 [-1,0] 与 [0,1] 两个 hex 块，
| 各 (4,8,8)，合起来跟 8x8x8 的单块完全等价。用来测试 snappy 多 block 支持。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 1.0;

vertices
(
    (-1 -1 -1)   //  0
    ( 0 -1 -1)   //  1
    ( 1 -1 -1)   //  2
    ( 1  1 -1)   //  3
    ( 0  1 -1)   //  4
    (-1  1 -1)   //  5
    (-1 -1  1)   //  6
    ( 0 -1  1)   //  7
    ( 1 -1  1)   //  8
    ( 1  1  1)   //  9
    ( 0  1  1)   // 10
    (-1  1  1)   // 11
);

blocks
(
    // block A: 左块 [-1,0]，沿 x=4 细分
    hex (0 1 4 5 6 7 10 11) (4 8 8) simpleGrading (1 1 1)
    // block B: 右块 [0,1]，沿 x=4 细分
    hex (1 2 3 4 7 8 9 10)  (4 8 8) simpleGrading (1 1 1)
);

edges ( );

boundary
(
    walls
    {
        type wall;
        faces
        (
            // -z (bottom)
            (0 5 4 1)
            (1 4 3 2)
            // +z (top)
            (6 7 10 11)
            (7 8 9 10)
            // -y
            (0 1 7 6)
            (1 2 8 7)
            // +y
            (5 11 10 4)
            (4 10 9 3)
            // -x
            (0 6 11 5)
            // +x
            (2 3 9 8)
        );
    }
);

mergePatchPairs ( );
