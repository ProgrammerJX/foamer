/*--------------------------------*- C++ -*----------------------------------*\
| snappyHexMesh dict 在 sphere 上扩 2 层 prism layers，验证 addLayers 拓扑。
| 背景 4x4x4 在 [-2,2]^3，sphere.stl 半径 0.7 居中；locationInMesh (1.7 0 0) 在球外。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    sphere.stl
    {
        type triSurfaceMesh;
        name sphere;
    }
}

castellatedMeshControls
{
    maxLocalCells       100000;
    maxGlobalCells      200000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        sphere { level (1 1); }
    }
    locationInMesh (1.7 0.0 0.0);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch       3;
    nSmoothInternal    1;
    tolerance          2.0;
    nSolveIter         30;
    nRelaxIter         0;
    nFeatureSnapIter   10;
}

addLayersControls
{
    relativeSizes       false;
    expansionRatio      1.2;
    firstLayerThickness 0.02;
    finalLayerThickness 0.3;
    minThickness        0.001;
    nGrow               0;
    featureAngle        60;
    layers
    {
        sphere { nSurfaceLayers 2; }
    }
}
