/*--------------------------------*- C++ -*----------------------------------*\
| 高分辨率 cylinder1 测试（L6 = cell 0.00391）：
| - 针径 D≈0.02 → 周向 ~16 cell，长 0.6 → 轴向 ~150 cell；针外形非常平滑。
| - 依赖 LEVEL_CAP ≥ 6（Refine #10：encodeLeafKey 10-bit 子位置字段）。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    cylinder1.stl
    {
        type triSurfaceMesh;
        name cylinder1;
    }
}

castellatedMeshControls
{
    maxLocalCells       4000000;
    maxGlobalCells      8000000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        cylinder1 { level (6 6); }
    }
    locationInMesh (0.9 0.9 0.9);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch       3;
    tolerance          2.0;
    nSolveIter         30;
    nRelaxIter         5;
    nFeatureSnapIter   10;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
}
