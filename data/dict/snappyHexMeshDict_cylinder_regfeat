/*--------------------------------*- C++ -*----------------------------------*\
| cylinder1 + refinementRegions(mode distance) + features { surface ... }
| 测试 phase 2：snappy 的 castellated 阶段能识别 region + feature 规则。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

perFacePatches  true;

geometry
{
    cylinder1.stl
    {
        type triSurfaceMesh;
        name cylinder1;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      4000000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        cylinder1 { level (3 3); }   // surface 自身只到 3
    }
    refinementRegions
    {
        cylinder1
        {
            mode    distance;
            levels  ( (0.05 4) (0.10 3) );  // 距 5% → 4，10% → 3
        }
    }
    features
    (
        { surface cylinder1; level 5; distance 0.02; }
    );
    locationInMesh (0.9 0.9 0.9);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch       3;
    tolerance          2.0;
    nSolveIter         30;
    nRelaxIter         5;
    nFeatureSnapIter   10;
    implicitFeatureSnap true;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
}
