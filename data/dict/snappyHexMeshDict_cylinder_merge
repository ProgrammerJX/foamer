/*--------------------------------*- C++ -*----------------------------------*\
| cylinder1 + mergePatchFaces：snappy castellated 切碎的 sub-quad 在 boundary
| 上合回大 face。验证 split-face / sub-quad 逆操作。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

perFacePatches    false;
mergePatchFaces   true;

geometry
{
    cylinder1.stl
    {
        type triSurfaceMesh;
        name cylinder1;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      4000000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        cylinder1 { level (4 4); }
    }
    locationInMesh (0.9 0.9 0.9);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch       3;
    tolerance          2.0;
    nSolveIter         30;
    nRelaxIter         5;
    nFeatureSnapIter   10;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
}
