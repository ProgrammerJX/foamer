/*--------------------------------*- C++ -*----------------------------------*\
| snappyHexMesh dict for cylinder1.stl in 8x8x8 box [-1, 1]^3.
| 圆柱周围 base-cell 升到 level 2（cell size 0.0625），缓冲层 level 1（0.125），
| 其余 level 0（0.25）。locationInMesh 取一个远离圆柱的角，保证保留外部域。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    cylinder1.stl
    {
        type triSurfaceMesh;
        name cylinder1;
    }
}

castellatedMeshControls
{
    maxLocalCells       200000;
    maxGlobalCells      400000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        cylinder1 { level (2 2); }
    }
    // 远离圆柱的角点；圆柱外的子格全部保留。
    locationInMesh (0.9 0.9 0.9);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch       3;
    tolerance          2.0;
    nSolveIter         30;
    nRelaxIter         5;
    nFeatureSnapIter   10;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
}
