/*--------------------------------*- C++ -*----------------------------------*\
| snappyHexMesh dict 同时使用 sphere 和 cylinder1 两张 STL，验证多 surface 加密
| 与 patch 分离功能。背景仍是 8x8x8 box [-1,1]^3；sphere 在原点附近，cylinder1 与
| 之有重叠。locationInMesh 取远角 (0.9,0.9,0.9) 保证两者都被"切除"剩下外部域。
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    sphere.stl
    {
        type triSurfaceMesh;
        name sphere;
    }
    cylinder1.stl
    {
        type triSurfaceMesh;
        name cylinder1;
    }
}

castellatedMeshControls
{
    maxLocalCells       200000;
    maxGlobalCells      400000;
    minRefinementCells  0;
    nCellsBetweenLevels 1;
    resolveFeatureAngle 30;
    refinementSurfaces
    {
        sphere    { level (1 1); }
        cylinder1 { level (2 2); }
    }
    locationInMesh (0.9 0.9 0.9);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch       3;
    tolerance          2.0;
    nSolveIter         30;
    nRelaxIter         5;
    nFeatureSnapIter   10;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
}
